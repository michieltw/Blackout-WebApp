// Core user and person tables
Table users {
  id integer [pk, increment]
  username varchar [unique, not null]
  email varchar [unique, not null]
  password_hash varchar [not null]
  first_name varchar
  last_name varchar
  profile_photo_url varchar
  phone_number varchar
  date_of_birth date
  user_role user_role [not null, default: 'player']
  user_status user_status [default: 'active']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  last_login_at timestamp
  Note: 'Core user account table; links to persons via user_id'
}

Table persons {
  id integer [pk, increment]
  user_id integer [ref: - users.id]
  full_name varchar [not null]
  date_of_birth date
  gender varchar
  nationality varchar
  phone_number varchar
  email varchar
  emergency_contact_name varchar
  emergency_contact_phone varchar
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  Note: 'Person profile; one-to-one with users'
}

Table user_preferences {
  id integer [pk, increment]
  user_id integer [not null]
  theme varchar [default: 'light']
  language varchar [default: 'en']
  notifications_enabled boolean [default: true]
  email_notifications boolean [default: true]
  push_notifications boolean [default: true]
  sms_notifications boolean [default: false]
  privacy_level varchar [default: 'public']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Ref: user_preferences.user_id > users.id [delete: cascade]

// Roles and permissions
Table roles {
  id integer [pk, increment]
  role_name varchar [unique, not null]
  description text
  is_system_role boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table role_permissions {
  id integer [pk, increment]
  role_id integer [not null]
  permission_type permission_type [not null]
  created_at timestamp [default: `now()`]
}

Ref: role_permissions.role_id > roles.id [delete: cascade]

Table user_roles {
  id integer [pk, increment]
  user_id integer [not null]
  role_id integer [not null]
  organization_id integer
  created_at timestamp [default: `now()`]
  indexes {
    (user_id, role_id, organization_id) [unique, name: 'uq_user_role_org']
  }
}

Ref: user_roles.user_id > users.id [delete: cascade]
Ref: user_roles.role_id > roles.id [delete: cascade]

// Organizations and structure
Table organizations {
  id integer [pk, increment]
  organization_name varchar [not null]
  organization_type organization_type [not null]
  parent_organization_id integer
  description text
  logo_url varchar
  banner_url varchar
  website_url varchar
  email varchar
  phone_number varchar
  address varchar
  city varchar
  state_province varchar
  postal_code varchar
  country varchar
  financial_year_start_month integer
  federation_level varchar
  tax_id varchar
  federation_affiliate_number varchar [note: 'IJshockey Nederland or other federation ID']
  ijshockey_org_id varchar [note: 'IJshockey Nederland organization ID for external syncing']
  compliance_certifications text [note: 'JSON or comma-separated certifications']
  created_by_user_id integer
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_archived boolean [default: false]
  Note: 'Top-level organization (league, club, association)'
}

Ref: organizations.parent_organization_id > organizations.id [delete: set null]

Ref: organizations.created_by_user_id > users.id

Table clubs {
  id integer [pk, increment]
  organization_id integer [not null]
  club_name varchar [not null]
  club_code varchar [unique]
  logo_url varchar
  banner_url varchar
  home_color varchar
  away_color varchar
  description text
  founded_year integer
  website_url varchar
  email varchar
  phone_number varchar
  address varchar
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_archived boolean [default: false]
}

Ref: clubs.organization_id > organizations.id [delete: cascade]

// Conferences and Divisions
Table conferences {
  id integer [pk, increment]
  organization_id integer [not null]
  season_id integer
  conference_name varchar [not null]
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Ref: conferences.organization_id > organizations.id [delete: cascade]

Table divisions {
  id integer [pk, increment]
  conference_id integer
  organization_id integer [not null]
  registration_id varchar [unique]
  ijshockey_division_id varchar [note: 'IJshockey Nederland division ID for external syncing']
  division_name varchar [not null]
  division_tier division_tier [not null]
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Ref: divisions.conference_id > conferences.id [delete: set null]
Ref: divisions.organization_id > organizations.id [delete: cascade]

// Seasons
Table seasons {
  id integer [pk, increment]
  season_name varchar [not null]
  season_year integer [not null, unique]
  start_date date [not null]
  end_date date [not null]
  registration_start_date date
  registration_end_date date
  registration_fee decimal(10,2)
  team_fee decimal(10,2)
  player_fee decimal(10,2)
  is_active boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  Note: 'Global seasons that any organization can adopt'
}

Table org_seasons {
  id integer [pk, increment]
  organization_id integer [not null]
  season_id integer [not null]
  adoption_date date [default: `now()`]
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  indexes {
    (organization_id, season_id) [unique, name: 'uq_org_season_adoption']
  }
  Note: 'Links organizations to seasons they adopt'
}

Ref: org_seasons.organization_id > organizations.id [delete: cascade]
Ref: org_seasons.season_id > seasons.id [delete: cascade]

Table season_phases {
  id integer [pk, increment]
  season_id integer [not null]
  phase_name season_phase [not null]
  start_date date [not null]
  end_date date [not null]
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Ref: season_phases.season_id > seasons.id [delete: cascade]

// Teams
Table teams {
  id integer [pk, increment]
  club_id integer [not null]
  division_id integer
  conference_id integer
  registration_id varchar [unique]
  ijshockey_team_id varchar [note: 'IJshockey Nederland team ID for external syncing']
  team_name varchar [not null]
  team_code varchar
  home_color varchar
  away_color varchar
  logo_url varchar
  team_status team_status [default: 'active']
  budget_amount decimal(15,2)
  manager_name varchar
  manager_contact varchar
  assistant_coach varchar
  goalie_coach varchar
  franchise_start_year integer
  team_website varchar
  social_media_handles text [note: 'JSON or comma-separated handles']
  insurance_provider varchar
  insurance_policy_number varchar
  goalsong varchar [note: 'Goal celebration song title and/or URL']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_archived boolean [default: false]
  Note: 'Team within a club; registration_id is Dutch hockey registration number'
}

Ref: teams.club_id > clubs.id [delete: cascade]
Ref: teams.division_id > divisions.id [delete: set null]
Ref: teams.conference_id > conferences.id [delete: set null]

Table team_managers {
  id integer [pk, increment]
  team_id integer [not null]
  user_id integer [not null]
  role varchar [default: 'manager']
  created_at timestamp [default: `now()`]
  indexes {
    (team_id, user_id) [unique, name: 'uq_team_manager']
  }
}

Ref: team_managers.team_id > teams.id [delete: cascade]
Ref: team_managers.user_id > users.id [delete: cascade]

// Players and Rosters
Table players {
  id integer [pk, increment]
  person_id integer [not null]
  user_id integer
  registration_id varchar [unique]
  ijshockey_player_id varchar [note: 'IJshockey Nederland player ID for external syncing']
  player_status player_status [default: 'active']
  free_agent_status player_free_agent_status [default: 'free_agent']
  free_agent_since_date date [note: 'Date player became a free agent']
  preferred_name varchar [note: 'Display name if different from legal name']
  primary_position position [not null]
  secondary_position position
  jersey_number integer
  preferred_jersey_number integer
  height_cm integer
  weight_kg integer
  shoots varchar
  handedness varchar
  equipment_size_preferences text
  shirt_size varchar
  international_team varchar [note: 'Team representing the player internationally']
  agent_name varchar
  agent_contact varchar
  goalsong varchar [note: 'Goal celebration song title and/or URL']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  Note: 'Player profile linked to person; registration_id is Dutch hockey registration number'
}

Ref: players.person_id > persons.id [delete: cascade]
Ref: players.user_id > users.id [delete: set null]

Table rosters {
  id integer [pk, increment]
  team_id integer [not null]
  season_id integer [not null]
  roster_name varchar
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  indexes {
    (team_id, season_id) [unique, name: 'uq_team_season_roster']
