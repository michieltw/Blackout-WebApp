// --- Tabblad 2: Social Hub, Ecosysteem & Synchronisatie ---
// --- Social Hub ---
Table messages {
  id integer [pk, increment]
  sender_id integer [ref: > users.id]
  receiver_id integer [ref: > users.id]
  channel_id integer [note: 'Optional: group/team chat ID']
  content text [not null]
  message_type message_type [not null, default: 'direct_message']
  priority message_priority [not null, default: 'normal']
  is_read boolean [default: false]
  created_at timestamp [default: `now()`]
}

Table posts {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  content text
  media_url varchar
  is_flagged boolean [default: false]
  created_at timestamp [default: `now()`]
}

Table comments {
  id integer [pk, increment]
  post_id integer [ref: > posts.id]
  user_id integer [ref: > users.id]
  content text [not null]
  created_at timestamp [default: `now()`]
}

Table friendships {
  user_id integer [ref: > users.id]
  friend_id integer [ref: > users.id]
  status varchar [default: 'accepted'] // pending, accepted, blocked
  created_at timestamp [default: `now()`]
  indexes {
    (user_id, friend_id) [unique]
  }
}

// --- Ecosystem & Business ---
Table sponsors {
  id integer [pk, increment]
  organization_id integer [ref: > organizations.id]
  name varchar [not null]
  contract_start_date date
  contract_end_date date
  amount_secured decimal(15,2)
  logo_url varchar
  status varchar [default: 'active']
}

Table invoices {
  id integer [pk, increment]
  payer_id integer [ref: > users.id]
  payee_id integer [ref: > organizations.id]
  amount decimal(15,2) [not null]
  currency varchar [default: 'EUR']
  status invoice_status [default: 'draft']
  due_date date
  created_at timestamp [default: `now()`]
}

Table transactions {
  id integer [pk, increment]
  invoice_id integer [ref: > invoices.id]
  amount decimal(15,2)
  payment_method payment_method
  payment_status payment_status [default: 'pending']
  transaction_date timestamp [default: `now()`]
}

Table inventory {
  id integer [pk, increment]
  owner_id integer [not null, note: 'Could be team_id or user_id']
  item_name varchar [not null]
  category varchar
  quantity integer [default: 1]
  status varchar [default: 'available']
  updated_at timestamp [default: `now()`]
}

// --- Offline Sync & Device Management ---
Table devices {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  device_name varchar
  device_type varchar [note: 'mobile, tablet, desktop']
  last_sync_at timestamp
  device_token varchar
}

Table offline_sync_queue {
  id integer [pk, increment]
  device_id integer [ref: > devices.id]
  action_type varchar [not null]
  payload text [note: 'JSON string of the data to sync']
  status varchar [default: 'pending'] // pending, synced, error
  created_at timestamp [default: `now()`]
}

// --- Multimedia & Notifications ---

Table media_assets {
  id integer [pk, increment]
  owner_id integer [not null]
  file_url varchar [not null]
  file_type varchar [note: 'image, video, document']
  file_size_bytes integer
  created_at timestamp [default: `now()`]
}

Table notifications {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  type notification_type [not null]
  content text
  is_read boolean [default: false]
  created_at timestamp [default: `now()`]
}
