  added_date date
  removed_date date
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  indexes {
    (roster_id, player_id) [unique, name: 'uq_roster_player']
  }
}

Ref: roster_players.roster_id > rosters.id [delete: cascade]
Ref: roster_players.player_id > players.id [delete: cascade]

Table lineups {
  id integer [pk, increment]
  game_id integer [not null]
  team_id integer [not null]
