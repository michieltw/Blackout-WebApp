  id integer [pk, increment]
  gas_integration_id integer [not null]
  script_name varchar
  execution_status varchar
  execution_result text
  executed_at timestamp
  created_at timestamp [default: `now()`]
}

Ref: gas_executions.gas_integration_id > gas_integration.id [delete: cascade]

// Integration: Google Sheets
Table google_sheets_config {
  id integer [pk, increment]
  organization_id integer [not null]
  sheet_id varchar [not null]
  sheet_name varchar
  sheet_url varchar
  api_key varchar [not null]
  sync_direction varchar [default: 'bidirectional']
  is_active boolean [default: true]
  last_synced_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  Note: 'Google Sheets configuration for data sync'
}

Ref: google_sheets_config.organization_id > organizations.id [delete: cascade]

Table google_sheets_sync_log {
  id integer [pk, increment]
  google_sheets_config_id integer [not null]
  sync_type varchar
  rows_synced integer
  sync_status varchar
  error_message text
  synced_at timestamp
  created_at timestamp [default: `now()`]
}

Ref: google_sheets_sync_log.google_sheets_config_id > google_sheets_config.id [delete: cascade]

// Archive
Table archived_records {
  id integer [pk, increment]
  entity_type varchar [not null]
  entity_id integer [not null]
  entity_data text [not null]
  archived_by_user_id integer
  archived_reason text
  archived_at timestamp [default: `now()`]
  Note: 'Soft-delete archive for historical records'
}

Ref: archived_records.archived_by_user_id > users.id [delete: set null]

// Jobs and Background Tasks
Table jobs {
  id integer [pk, increment]
  job_name varchar [not null]
  job_type varchar
  job_status varchar [default: 'pending']
  job_payload text
  retry_count integer [default: 0]
  max_retries integer [default: 3]
  created_at timestamp [default: `now()`]
  started_at timestamp
  completed_at timestamp
  error_message text
  created_by_user_id integer
}

Ref: jobs.created_by_user_id > users.id [delete: set null]

